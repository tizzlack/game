# Übersetzungen Deutsch/Englisch. L.t("schluessel") liefert den Text in der aktuellen Sprache.
extends Node

var lang := "de"

func set_lang(l: String) -> void:
	lang = l if l in ["de", "en"] else "en"

func t(key: String) -> String:
	var d: Dictionary = DE if lang == "de" else EN
	if d.has(key):
		return d[key]
	if EN.has(key):
		return EN[key]
	return key

